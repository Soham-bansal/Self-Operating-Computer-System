# Copy this file to .env (setup.bat does it for you) and fill in your keys.
# You can also edit all of this from the app's ⚙ Settings button.

# --- API keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Per-agent provider: openai | gemini | ollama ---
PLANNER_PROVIDER=openai
NAVIGATOR_PROVIDER=openai
VERIFIER_PROVIDER=openai

# --- Model per agent (must match the provider) ---
# OpenAI:  gpt-4o, gpt-4.1-mini      Gemini: gemini-2.5-flash, gemini-2.5-pro
# Ollama vision: llama3.2-vision, qwen2.5vl   Ollama text: llama3.1
MODEL_PLANNER=gpt-4.1-mini
MODEL_NAVIGATOR=gpt-4o
MODEL_VERIFIER=gpt-4.1-mini

# --- Perception server ---
OMNI_URL=http://127.0.0.1:8010

# --- Web (DOM) browser: dedicated agent Chrome profile (auto-created) ---
USE_REAL_CHROME_PROFILE=true
CHROME_USER_DATA_DIR=
CHROME_PROFILE_DIR=Default

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
